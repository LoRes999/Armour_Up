# Copy to .env. None of these are secrets: a Firebase web config identifies
# the project, and the security rules protect the data.

# Accounts and cloud sync. 0 = everything stays on the phone, as before.
EXPO_PUBLIC_CLOUD=0

# This computer's address on your Wi-Fi (ipconfig -> IPv4), so the phone can
# reach the local emulators (npm run emulators). While it is filled in the app
# uses the emulators' demo project and ignores the live config below. Leave it
# empty to use the live project.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# The live project's web config (Firebase console -> Project settings ->
# Your apps -> Web app).
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBJQjyzpkWUlRuGes8LJpcgjJ8wxZxm1cA
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=strength-coach-a0023.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=strength-coach-a0023
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=strength-coach-a0023.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=898887930587
EXPO_PUBLIC_FIREBASE_APP_ID=1:898887930587:web:f1a00bddce58fdb913f2fe
