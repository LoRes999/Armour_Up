# Copy to .env and fill in. None of these are secrets: a Firebase web config
# identifies the project, and the security rules protect the data.

# Accounts and cloud sync. Leave at 0 until the account screens are built.
EXPO_PUBLIC_CLOUD=0

# From the Firebase console: Project settings -> Your apps -> Web app.
# For the local emulators any project id starting "demo-" works with no real
# project at all, and the API key can be any non-empty string.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-strength-coach
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# This computer's address on your Wi-Fi (ipconfig -> IPv4), so the phone can
# reach the emulators. Leave empty to use the real cloud.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
